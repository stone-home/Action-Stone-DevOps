# Based on https://github.com/github/gitignore/blob/main/Python.gitignore
# (main, fetched 2026-09-21). This repo is Actions + shell + Python/LaTeX helper
# scripts, not a Python package app.

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py.cover
*.lcov
.hypothesis/
.pytest_cache/
cover/

# Sphinx documentation
docs/_build/

# Jupyter Notebook
.ipynb_checkpoints

# Environments
.env
.envrc
.env.*
!.env.example
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Ruff
.ruff_cache/

# PyPI configuration file
.pypirc

# Temporary file for partial code execution
tempCodeRunnerFile.py

# Node (composite actions may run npm locally)
# Source: https://github.com/github/gitignore/blob/main/Node.gitignore
node_modules/
npm-debug.log*
.npm

# Editor / OS
.idea/
.DS_Store
._*
*.swp

# Nested checkout of this repo (do not commit). This repository is the DevOps hub.
.devops/
# Local checkout of AI-HomeLab-Skills (do not commit)
.skills-hub/
