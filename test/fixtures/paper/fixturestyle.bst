% Test fixture bibliography style.
%
% A deliberately minimal BibTeX style, written for this test suite rather than derived
% from any distributed style file, so the repository carries no third-party .bst.
% It exists so a test can prove that a .bst sitting in the project root is copied into
% the build sandbox: every \bibitem it emits carries the marker below, which cannot
% appear if bibtex silently fell back to some other style.
%
% Output is entry-type agnostic and citation-ordered; readability of the result is not
% the point, reaching bibtex at all is.

ENTRY
  { author title year journal booktitle publisher institution school note }
  {}
  { label }

MACRO {jan} {"January"}
MACRO {feb} {"February"}
MACRO {mar} {"March"}
MACRO {apr} {"April"}
MACRO {may} {"May"}
MACRO {jun} {"June"}
MACRO {jul} {"July"}
MACRO {aug} {"August"}
MACRO {sep} {"September"}
MACRO {oct} {"October"}
MACRO {nov} {"November"}
MACRO {dec} {"December"}

FUNCTION {write.field}
{ duplicate$ empty$
    { pop$ }
    { write$ ". " write$ }
  if$
}

FUNCTION {write.container}
{ booktitle empty$
    { journal empty$
        { publisher empty$
            { institution empty$
                { school }
                { institution }
              if$
            }
            { publisher }
          if$
        }
        { journal }
      if$
    }
    { booktitle }
  if$
  write.field
}

FUNCTION {write.entry}
{ newline$
  "\bibitem{" cite$ * "}" * write$ newline$
  "%% fixturestyle" write$ newline$
  author write.field
  title write.field
  write.container
  year write.field
  newline$
}

FUNCTION {article} { write.entry }
FUNCTION {book} { write.entry }
FUNCTION {booklet} { write.entry }
FUNCTION {conference} { write.entry }
FUNCTION {inbook} { write.entry }
FUNCTION {incollection} { write.entry }
FUNCTION {inproceedings} { write.entry }
FUNCTION {manual} { write.entry }
FUNCTION {mastersthesis} { write.entry }
FUNCTION {misc} { write.entry }
FUNCTION {phdthesis} { write.entry }
FUNCTION {proceedings} { write.entry }
FUNCTION {techreport} { write.entry }
FUNCTION {unpublished} { write.entry }
FUNCTION {default.type} { write.entry }

READ

FUNCTION {begin.bib}
{ "\begin{thebibliography}{99}" write$ newline$
  "%% generated by fixturestyle.bst" write$ newline$
}

FUNCTION {end.bib}
{ newline$ "\end{thebibliography}" write$ newline$
}

EXECUTE {begin.bib}
ITERATE {call.type$}
EXECUTE {end.bib}
